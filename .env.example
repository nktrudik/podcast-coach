API_KEY=your_openrouter_api_key
ADMIN_API_KEY=your_admin_key

STT_MODEL_NAME=mistralai/voxtral-small-24b-2507
LLM_MODEL_NAME=inclusionai/ring-2.6-1t:free
BASE_URL=https://openrouter.ai/api/v1

# Docker Compose uses the postgres service hostname.
# On Render, set this to the Render PostgreSQL Internal Database URL.
DATABASE_URL=postgresql://podcast_coach:podcast_coach@postgres:5432/podcast_coach
LOG_LEVEL=INFO
LOG_FILE_PATH=./storage/logs/backend.log
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

HOST=127.0.0.1
PORT=8000

EXTERNAL_REQUEST_TIMEOUT_SECONDS=45
EXTERNAL_REQUEST_MAX_ATTEMPTS=3
EXTERNAL_REQUEST_RETRY_DELAY_SECONDS=3
STT_REQUEST_MAX_ATTEMPTS=6
STT_REQUEST_RETRY_DELAY_SECONDS=4
LLM_MEMORY_MESSAGES_LIMIT=5

MAX_VIDEO_DURATION_MINUTES=30
UPLOADED_VIDEOS_LIMIT=5
CHAT_SESSIONS_PER_VIDEO_LIMIT=5

YOUTUBE_COOKIES_FILE=
YOUTUBE_MAX_RETRIES=3
YOUTUBE_RETRY_DELAY_SECONDS=10

VITE_API_BASE_URL=http://localhost:8000
